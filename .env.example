# Copy to .env.local (local) or add each variable in Vercel → Project → Settings → Environment Variables.
# Never commit real values. See DEPLOYMENT.md for what each variable does.

# ── Supabase (Project Settings → API) — REQUIRED ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never exposed to the browser. Calendar sync, Calendly and webhooks need it.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app, no trailing slash (OAuth redirects, auth emails, webhooks) — REQUIRED in production
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token) — REQUIRED for the scheduled sync
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Google Calendar (optional) ────────────────────────────────
# Authorised redirect URI: {NEXT_PUBLIC_SITE_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Reviews import (optional, Places API New) ──────────
GOOGLE_PLACES_API_KEY=

# ── Calendly (optional) ───────────────────────────────────────
# The personal access token is pasted in Settings → Integrations (stored server side).
# Public booking page embedded on /booking:
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/wissnails00/wissnails
# Fallback signing key, only for a webhook created by hand in Calendly (the app generates its own):
CALENDLY_WEBHOOK_SIGNING_KEY=

# ── Options ───────────────────────────────────────────────────
# Set to false once your account exists to close sign-ups
NEXT_PUBLIC_ALLOW_SIGNUP=true
# Salon timezone for appointment times (default Europe/Paris)
NEXT_PUBLIC_SALON_TIMEZONE=Europe/Paris
